# Copia este archivo como .env y rellena los valores reales.
# El archivo .env está en .gitignore y NO se sube a GitHub.

# Cadena de conexión a PostgreSQL (formato clave=valor de Npgsql).
# Para Neon: toma host, usuario, contraseña y base de datos de tu panel.
ConnectionStrings__DefaultConnection=Host=TU_HOST.neon.tech;Database=TU_BD;Username=TU_USUARIO;Password=TU_PASSWORD;SSL Mode=Require;Channel Binding=Require
